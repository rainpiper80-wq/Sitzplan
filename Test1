<!DOCTYPE html>
<!-- Diese App läuft vollständig offline im Browser. Alle Daten (Klassen, Schüler, Punkte, Noten, Notizen) werden ausschließlich lokal über localStorage gespeichert; es werden keine Daten an einen Server übertragen. -->
<html lang="de">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'none'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none';">
<title>Sitzplan</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    background: #f4efe4;
    color: #2b2b28;
    margin: 0;
  }
  .chalk-header {
    background: #1b3a2f;
    color: #f4efe4;
    padding: 14px 20px;
    text-align: center;
    border-bottom: 6px solid #7a5c3a;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 2px;
  }
  .class-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #e4d9bf;
    border-bottom: 1px solid #c9bb98;
    padding: 8px 16px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .class-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fffdf8;
    border: 1px solid #c9bb98;
    border-radius: 6px;
    padding: 5px 6px 5px 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }
  .class-tab.active {
    background: #1b3a2f;
    color: #f4efe4;
    border-color: #1b3a2f;
  }
  .class-tab .class-del {
    background: rgba(0,0,0,.15);
    border: none;
    border-radius: 4px;
    width: 18px;
    height: 18px;
    color: inherit;
    cursor: pointer;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .class-bar .new-class {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    margin-left: 6px;
  }
  .class-bar .new-class input {
    width: 90px;
    border: 1px solid #c9bb98;
    border-radius: 5px;
    padding: 5px 7px;
    font-size: 13px;
  }
  .class-bar .new-class button {
    background: #1b3a2f;
    color: #f4efe4;
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .display-settings-wrap { margin-left: auto; flex-shrink: 0; display: flex; gap: 8px; }
  .display-settings-btn {
    background: #fffdf8;
    border: 1px solid #c9bb98;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .counter-view-btn {
    background: #fffdf8;
    border: 1px solid #c9bb98;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .counter-view-btn.active {
    background: #1b3a2f;
    color: #f4efe4;
    border-color: #1b3a2f;
  }
  .print-btn {
    background: #fffdf8;
    border: 1px solid #c9bb98;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  @media print {
    @page { size: landscape; margin: 8mm; }
    body { background: #fff; }
    .class-bar, .sidebar, .note-popover, .grade-preview, .display-menu, .chalk-header {
      display: none !important;
    }
    .layout {
      padding: 0;
      overflow: visible;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .seat-area {
      transform: scale(0.72);
      transform-origin: center center;
    }
    .btns, .note-btn, .note-btn-inline { display: none !important; }
  }
  .display-menu {
    position: fixed;
    width: 220px;
    background: #fffdf8;
    border: 1px solid #d9cfb4;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,.22);
    padding: 8px 10px;
    z-index: 500;
    display: none;
  }
  .display-menu.open { display: block; }
  .display-menu .dm-title { font-size: 12px; font-weight: 700; margin-bottom: 6px; color: #5c4a2f; }
  .display-menu .dm-row {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    padding: 4px 0;
    cursor: pointer;
  }
  .layout {
    display: flex;
    gap: 24px;
    padding: 20px;
    align-items: flex-start;
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  .seat-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
  }
  .blocks {
    display: flex;
    gap: 40px;
    flex: 0 0 auto;
    justify-content: center;
    flex-wrap: nowrap;
  }
  .class-footer {
    margin-top: 18px;
    font-weight: 800;
    font-size: 60px;
    color: #1b3a2f;
    text-align: center;
  }
  .block-title {
    text-align: center;
    margin-bottom: 10px;
    font-size: 16px;
    color: #5c4a2f;
    font-weight: 700;
  }
  .grid {
    display: grid;
    gap: 10px;
    background: #e4d9bf;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid #c9bb98;
  }
  .seat {
    width: 112px;
    height: 130px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px;
    cursor: pointer;
    user-select: none;
    position: relative;
  }
  .seat.empty {
    border: 2px dashed #b8ac93;
    background: transparent;
  }
  .seat.empty:hover { border-color: #8a7d5f; background: #ece4d1; }
  .seat.filled { box-shadow: 0 1px 3px rgba(0,0,0,.2); }
  .seat.selected { outline: 3px solid #2b6cb0; outline-offset: 2px; }
  .seat .name { font-size: 13px; font-weight: 700; text-align: center; line-height: 1.15; margin-bottom: 3px; word-break: break-word; cursor: pointer; }
  .seat .points { font-size: 20px; font-weight: 700; margin-bottom: 3px; }
  .seat .btns { display: flex; gap: 6px; margin-bottom: 5px; }
  .seat .btns button {
    background: rgba(0,0,0,.18);
    border: none;
    border-radius: 5px;
    width: 22px;
    height: 22px;
    color: inherit;
    cursor: pointer;
    font-weight: 700;
    line-height: 1;
  }
  .badge-grade {
    position: absolute;
    top: 3px;
    left: 3px;
    background: rgba(255,255,255,.85);
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 4px;
    line-height: 1.3;
    border: none;
    cursor: pointer;
    font-family: inherit;
    min-width: 22px;
  }
  .badge-task {
    position: absolute;
    top: 3px;
    right: 3px;
    background: #c1392b;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 1px rgba(0,0,0,.25);
  }
  .note-btn {
    position: absolute;
    bottom: 3px;
    right: 3px;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: none;
    background: rgba(0,0,0,.15);
    color: inherit;
    font-size: 11px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .note-btn.has-note { background: #ffe066; color: #4a3b00; box-shadow: 0 0 0 1px rgba(0,0,0,.2); }
  .note-btn-inline {
    width: 18px; height: 18px; border-radius: 4px; border: none;
    background: rgba(0,0,0,.18); color: inherit; font-size: 10px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .note-btn-inline.has-note { background: #ffe066; color: #4a3b00; }
  .chip-badge-task {
    background: #c1392b; color: #fff; font-size: 10px; font-weight: 800;
    width: 15px; height: 15px; border-radius: 50%; display: flex;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .chip-badge-grade {
    background: rgba(0,0,0,.15); font-size: 10.5px; font-weight: 700;
    padding: 1px 4px; border-radius: 4px; flex-shrink: 0;
    border: none; cursor: pointer; color: inherit; font-family: inherit;
  }
  .note-popover {
    position: fixed;
    width: 210px;
    background: #fffdf8;
    border: 1px solid #d9cfb4;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,.22);
    padding: 8px;
    z-index: 500;
    color: #2b2b28;
    cursor: default;
    display: none;
  }
  .note-popover.open { display: block; }
  .note-popover .note-title { font-size: 12px; font-weight: 700; margin-bottom: 6px; }
  .note-popover .task-toggle {
    width: 100%;
    text-align: left;
    background: #ece4d1;
    border: 1px solid #d9cfb4;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12.5px;
    cursor: pointer;
    margin-bottom: 8px;
  }
  .note-popover .task-toggle.active {
    background: #f6e4e0;
    border-color: #c1392b;
    color: #7a3223;
    font-weight: 700;
  }
  .note-popover .time-toggle.active {
    background: #dbe9f6;
    border-color: #2b6cb0;
    color: #1c4d80;
    font-weight: 700;
  }
  .grade-section { margin-bottom: 8px; }
  .grade-label { font-size: 12px; font-weight: 700; margin-bottom: 4px; color: #5c4a2f; }
  .grade-add-row { display: flex; gap: 6px; margin-bottom: 6px; }
  .grade-add-row input {
    flex: 1;
    border: 1px solid #d9cfb4;
    border-radius: 5px;
    padding: 3px 6px;
    font-size: 12.5px;
  }
  .grade-add-row button {
    background: #1b3a2f;
    color: #f4efe4;
    border: none;
    border-radius: 5px;
    width: 26px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .grade-list { display: flex; flex-wrap: wrap; gap: 5px; }
  .grade-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #ece4d1;
    border: 1px solid #d9cfb4;
    border-radius: 5px;
    padding: 2px 4px 2px 8px;
    font-size: 12px;
    font-weight: 700;
  }
  .grade-chip button {
    background: rgba(0,0,0,.15);
    border: none;
    border-radius: 3px;
    width: 15px;
    height: 15px;
    font-size: 10px;
    cursor: pointer;
    line-height: 1;
  }
  .note-popover textarea {
    width: 100%;
    min-height: 60px;
    font-size: 12.5px;
  }
  .note-popover .note-actions { display: flex; justify-content: flex-end; margin-top: 6px; }
  .note-popover .note-actions button {
    background: #1b3a2f; color: #f4efe4; border: none; border-radius: 5px;
    padding: 4px 10px; font-size: 12px; cursor: pointer;
  }
  .grade-preview {
    position: fixed;
    width: 190px;
    background: #fffdf8;
    border: 1px solid #d9cfb4;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,.22);
    padding: 8px 10px;
    z-index: 500;
    color: #2b2b28;
    cursor: default;
    display: none;
  }
  .grade-preview.open { display: block; }
  .grade-preview .gp-name { font-size: 12px; font-weight: 700; margin-bottom: 4px; }
  .grade-preview .gp-grade { font-size: 13px; font-weight: 700; margin-bottom: 4px; }
  .grade-preview .gp-note { font-size: 12px; white-space: pre-wrap; word-break: break-word; }
  .badge-time {
    position: absolute;
    bottom: 3px;
    left: 3px;
    background: #2b6cb0;
    color: #fff;
    font-size: 11px;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 1px rgba(0,0,0,.25);
  }
  .chip-badge-time {
    background: #2b6cb0; color: #fff; font-size: 10px;
    width: 15px; height: 15px; border-radius: 50%; display: flex;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .sidebar {
    flex: 0 0 260px;
    background: #fffdf8;
    border: 1px solid #d9cfb4;
    border-radius: 10px;
    padding: 14px;
    min-height: 300px;
  }
  .sidebar h3 { margin: 0 0 10px 0; font-size: 15px; display:flex; align-items:center; gap:6px;}
  textarea {
    width: 100%;
    border: 1px solid #d9cfb4;
    border-radius: 6px;
    padding: 6px;
    font-size: 13px;
    font-family: inherit;
    resize: vertical;
  }
  .add-btn {
    margin-top: 6px;
    width: 100%;
    background: #1b3a2f;
    color: #f4efe4;
    border: none;
    border-radius: 6px;
    padding: 6px 0;
    font-weight: 600;
    cursor: pointer;
  }
  .chip-list { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; min-height: 60px; }
  .chip {
    border-radius: 7px;
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
  }
  .chip .chip-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .chip .chip-bottom { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
  .chip.selected { outline: 3px solid #2b6cb0; outline-offset: 2px; }
  .chip .cname { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
  .chip .cbtns { display: flex; align-items: center; gap: 4px; }
  .chip .cbtns button {
    background: rgba(0,0,0,.18);
    border: none;
    border-radius: 4px;
    width: 20px;
    height: 20px;
    color: inherit;
    cursor: pointer;
    font-weight: 700;
  }
  .chip .del {
    background: none !important;
    opacity: .7;
    margin-left: 2px;
  }
  .empty-note { font-size: 13px; color: #8a7d5f; font-style: italic; }
  .backup-area { margin-top: 16px; display: flex; flex-direction: column; gap: 6px; }
  .backup-btn { background: #e4ecf1; border: 1px solid #b9cdd9; }
  .pdf-btn { background: #efe7f5; border: 1px solid #d3bfe6; width: 100%; }
  .backup-msg { font-size: 11.5px; color: #2b6b3f; min-height: 14px; }
  .backup-msg.error { color: #a52a1f; }
  .reset-area { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .reset-btn {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    background: #ece4d1; border: 1px solid #d9cfb4; border-radius: 6px;
    padding: 6px 0; font-size: 12.5px; cursor: pointer;
  }
  .danger-btn {
    background: #f6e4e0; border: 1px solid #e0c2b8; color: #7a3223;
  }
  .confirm-box {
    font-size: 12.5px; background: #fdf3e7; border: 1px solid #e0c2b8;
    border-radius: 6px; padding: 8px;
  }
  .confirm-box .row { display: flex; gap: 6px; margin-top: 6px; }
  .confirm-box .row button { flex: 1; border: none; border-radius: 5px; padding: 5px 0; cursor: pointer; }
  .legend { margin-top: 14px; font-size: 11px; color: #8a7d5f; line-height: 1.6; }
  .visually-hidden-file {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  .legend .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; }

/* iPad-Landschaft: Bedienleiste oben, Sitzplan darunter. Kein seitliches Abschneiden. */
@media (min-width: 700px) {
  html, body { width:100%; max-width:100%; overflow:hidden; }
  .chalk-header { padding:6px 12px; font-size:16px; border-bottom-width:3px; }
  .class-bar { padding:4px 8px; gap:5px; }
  .class-tab { padding:3px 5px 3px 8px; font-size:11px; }
  .class-tab .class-del { width:16px; height:16px; font-size:10px; }
  .class-bar .new-class { margin-left:2px; }
  .class-bar .new-class input { width:70px; padding:3px 5px; font-size:11px; }
  .class-bar .new-class button, .display-settings-btn, .counter-view-btn, .print-btn { padding:4px 7px; font-size:11px; }

  .layout {
    width:100vw;
    height:calc(100dvh - 72px);
    min-height:0;
    padding:6px 8px 8px;
    gap:6px;
    display:flex;
    flex-direction:column;
    align-items:stretch;
    overflow:hidden;
  }

  /* Die komplette Bedienfläche liegt oben und nimmt keine Breite vom Sitzplan weg. */
  .sidebar {
    order:-1;
    flex:0 0 auto;
    width:100%;
    height:116px;
    min-height:0;
    max-height:none;
    overflow:hidden;
    padding:6px 8px;
    border-radius:7px;
    display:grid;
    grid-template-columns:90px 220px 90px 1fr 150px 150px;
    grid-template-rows:auto 1fr;
    column-gap:7px;
    row-gap:4px;
    align-items:start;
  }
  .sidebar h3 { grid-column:1; grid-row:1; margin:0; font-size:11px; white-space:nowrap; }
  .sidebar textarea { grid-column:1 / 3; grid-row:2; width:100%; height:62px; padding:4px; font-size:10px; resize:none; }
  .sidebar .add-btn { grid-column:3; grid-row:2; width:100%; height:28px; margin:0; padding:4px; font-size:10px; }
  .sidebar .pdf-btn { grid-column:3; grid-row:1; width:100%; height:25px; margin:0 !important; padding:3px; font-size:9px; }
  #pdfFile, #pdfMsg { grid-column:3; }
  #pdfMsg { grid-row:1; margin-top:26px; font-size:8px; }
  .sidebar .chip-list {
    grid-column:4;
    grid-row:1 / 3;
    margin:0;
    height:96px;
    min-height:0;
    overflow-y:auto;
    display:flex;
    flex-direction:row;
    flex-wrap:wrap;
    align-content:flex-start;
    gap:3px;
    padding:2px;
    border:1px solid #e1d8c2;
    border-radius:5px;
  }
  .sidebar .chip { padding:3px 5px; gap:1px; border-radius:4px; min-width:74px; }
  .sidebar .chip .cname { font-size:9px; }
  .sidebar .chip .cbtns button { width:15px; height:15px; font-size:8px; }
  .sidebar .backup-area { grid-column:5; grid-row:1 / 3; margin:0; gap:4px; }
  .sidebar .reset-area { grid-column:6; grid-row:1 / 3; margin:0; gap:4px; }
  .sidebar .reset-btn { padding:4px; font-size:9px; }
  .sidebar .backup-msg { font-size:8px; min-height:9px; }
  .sidebar .legend { grid-column:5 / 7; grid-row:2; margin:0; display:none; }
  .sidebar > div:last-child { display:none; }

  .seat-area {
    flex:1 1 auto;
    min-width:0;
    min-height:0;
    width:100%;
    max-width:none;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-start;
    overflow:visible;
  }
  .blocks {
    width:auto;
    max-width:100%;
    gap:14px;
    flex:0 0 auto;
    justify-content:center;
    flex-wrap:nowrap;
  }
  .block-title { margin-bottom:4px; font-size:11px; }
  /* Die inline gesetzten Originalmaße werden hier bewusst überschrieben,
     damit alle drei Blöcke vollständig und mit gleichen Abständen sichtbar sind. */
  .blocks { gap:10px; width:max-content; max-width:100%; }
  .blocks > div:nth-child(1) .grid,
  .blocks > div:nth-child(3) .grid { grid-template-columns:repeat(4,70px) !important; grid-template-rows:repeat(3,76px) !important; }
  .blocks > div:nth-child(2) .grid { grid-template-columns:repeat(3,70px) !important; grid-template-rows:repeat(3,76px) !important; }
  .grid { gap:5px; padding:7px; border-radius:7px; }
  .seat { width:70px; height:76px; border-radius:6px; padding:4px; box-sizing:border-box; }
  .seat .name { font-size:10px; line-height:1.05; margin-bottom:2px; }
  .seat .points { font-size:15px; margin-bottom:2px; }
  .seat .btns { gap:3px; margin-bottom:2px; }
  .seat .btns button { width:18px; height:18px; font-size:11px; border-radius:4px; }
  .badge-grade { top:2px; left:2px; font-size:8px; padding:1px 3px; min-width:17px; }
  .badge-task { top:2px; right:2px; width:14px; height:14px; font-size:9px; }
  .note-btn { bottom:2px; right:2px; width:15px; height:15px; font-size:9px; }
  .class-footer { margin-top:5px; font-size:26px; }
}

/* Schmalere iPad-Landschaft: nur der Sitzplan wird leicht proportional verkleinert. */
@media (min-width:700px) and (max-width:1050px) {
  .sidebar { grid-template-columns:82px 190px 84px 1fr 130px 130px; height:108px; }
  .sidebar textarea { height:56px; }
  .sidebar .chip-list { height:88px; }
  .blocks { gap:10px; transform:none; margin-bottom:0; }
  .class-footer { font-size:23px; }
}


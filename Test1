  document.getElementById('gpGrade').textContent = 'Noten: ' + ((s.grades && s.grades.length) ? formatGrades(s.grades) : '–');
  document.getElementById('gpNote').textContent = s.note ? s.note : 'Keine Notiz hinterlegt.';
  pop.classList.add('open');
  positionPopover(pop, btnEl, 190, 120);

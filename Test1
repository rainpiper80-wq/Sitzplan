function renderGradeList(){
 const s=students.find(s=>s.id===noteTargetId),list=document.getElementById('gradeList');if(!s||!list)return;if(!s.grades||s.grades.length===0){list.innerHTML='<span style="font-size:12px;color:#8a7d5f;font-style:italic;">Noch keine Note</span>';return;}
 list.innerHTML=s.grades.map((g,i)=>`<span class="grade-chip${g.comment?' has-comment':''}" title="${g.comment?escapeHtml(g.comment):'Kein Kommentar hinterlegt'}"><span class="grade-chip-value" onclick="openGradeCommentPopover(${i}, this)">${escapeHtml(g.value)}${g.comment?' 💬':''}</span><button onclick="removeGradeEntry(${i})" aria-label="Note entfernen">✕</button></span>`).join('');
}

function openNotePopover(studentId, btnEl){
  closeGradePreview();
  noteTargetId = studentId;
  const s = students.find(s => s.id === studentId);
  if(!s) return;
  const pop = document.getElementById('notePopover');

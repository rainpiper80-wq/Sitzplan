<script>
/* PDF.js bewusst nicht eingebunden: diese Version hat keinerlei externe Abhängigkeiten. */ window.__pdfLibMissing = true;
const STORAGE_KEY = "sitzplan_offline_v1";
const BLOCKS = [
  { id: "L", label: "Block links", rows: 3, cols: 4 },
  { id: "M", label: "Block Mitte", rows: 3, cols: 3 },
  { id: "R", label: "Block rechts", rows: 3, cols: 4 },
];

let classes = [];       // {id, name, students:[], seats:{}}
let currentClassId = null;
let students = [];       // Referenz auf classes[aktuell].students
let seats = {};          // Referenz auf classes[aktuell].seats
let selection = null;    // {studentId, fromSeat}
let confirmMode = null;
let displaySettings = { grade: true, extraTask: true, extraTime: true };
let globalCounterView = false;
const revealedPoints = new Set(); // nur temporär im Speicher, wird nicht gesichert

function togglePointsReveal(studentId){
  if(revealedPoints.has(studentId)) revealedPoints.delete(studentId);
  else revealedPoints.add(studentId);
  render();
}

function toggleGlobalCounterView(){
  globalCounterView = !globalCounterView;
  save(); render();
}

function printSeatingPlan(){try{if(document.referrer===''&&window.matchMedia&&window.matchMedia('(display-mode: standalone)').matches)console.warn('Standalone/Home-Bildschirm-Modus erkannt: Drucken kann in Safari dort eingeschraenkt sein.');window.print();}catch(e){alert('Drucken ist fehlgeschlagen: '+e.message+'\n\nBitte oeffnen Sie diese Seite als normalen Tab in Safari (nicht ueber das Home-Bildschirm-Symbol) und versuchen Sie es erneut.');}}
function exportGradeList(){
 const old=document.querySelector('.grade-list-print');if(old)old.remove();const os=document.getElementById('gradeListPrintPageStyle');if(os)os.remove();const layer=document.createElement('section');layer.className='grade-list-print';const header=document.createElement('div');header.className='notes-print-header';header.innerHTML='<div><h1></h1><p>Alphabetisch nach Nachnamen</p></div><div class="notes-print-date"></div>';header.querySelector('h1').textContent='Notenliste – '+cls().name;header.querySelector('.notes-print-date').textContent='Datum: '+new Date().toLocaleDateString('de-DE');layer.appendChild(header);const table=document.createElement('table');table.innerHTML='<thead><tr><th>Nachname</th><th>Vorname</th><th>Noten mit Einzelkommentaren</th><th>Punkte</th></tr></thead>';const body=document.createElement('tbody'),split=name=>{const p=String(name||'').trim().split(/\s+/).filter(Boolean);return {last:p.length?p[p.length-1]:'',first:p.slice(0,-1).join(' ')}};let ss=students.slice().sort((a,b)=>{const x=split(a.name),y=split(b.name);return x.last.localeCompare(y.last,'de',{sensitivity:'base'})||x.first.localeCompare(y.first,'de',{sensitivity:'base'})});if(!ss.length){body.innerHTML='<tr><td colspan="4">Keine Schüler in dieser Klasse vorhanden.</td></tr>';}else ss.forEach(s=>{const n=split(s.name),tr=document.createElement('tr');[n.last,n.first,(s.grades&&s.grades.length)?formatGrades(s.grades):'',String(s.points==null?0:s.points)].forEach(x=>{const td=document.createElement('td');td.textContent=x;tr.appendChild(td)});body.appendChild(tr)});table.appendChild(body);layer.appendChild(table);document.body.appendChild(layer);const style=document.createElement('style');style.id='gradeListPrintPageStyle';style.textContent='@media print{@page{size:A4 portrait;margin:12mm}}';document.head.appendChild(style);document.body.classList.add('grades-printing');const cleanup=()=>{document.body.classList.remove('grades-printing');layer.remove();style.remove()};window.addEventListener('afterprint',cleanup,{once:true});try{window.print()}catch(e){cleanup();alert('Notenliste konnte nicht exportiert werden: '+e.message+'\n\nBitte oeffnen Sie diese Seite als normalen Tab in Safari (nicht ueber das Home-Bildschirm-Symbol) und versuchen Sie es erneut.')}}

function uid(){ return Math.random().toString(36).slice(2,10) + Date.now().toString(36); }

function migrateStudent(s){
  if(typeof s.hasExtraTask !== 'boolean') s.hasExtraTask = !!(s.extraTasks && s.extraTasks > 0);
  if(!Array.isArray(s.grades)) s.grades = (typeof s.grade === 'string' && s.grade) ? [s.grade] : [];
  s.grades = s.grades.map(function(g){
    if(g && typeof g === 'object' && !Array.isArray(g)) return { value: typeof g.value === 'string' ? g.value : String(g.value == null ? '' : g.value), comment: typeof g.comment === 'string' ? g.comment : '' };
    return { value: typeof g === 'string' ? g : String(g == null ? '' : g), comment: '' };
  });
  delete s.grade; if(typeof s.note !== 'string') s.note = ''; if(typeof s.extraTime !== 'boolean') s.extraTime = false; delete s.extraTasks;
}

function formatGrades(grades){
  return grades.map(function(g){ return g.comment ? (g.value + ' (' + g.comment + ')') : g.value; }).join(', ');
}

function cls(){
  return classes.find(c => c.id === currentClassId) || classes[0];
}

function syncCurrent(){
  const c = cls();
  currentClassId = c.id;
  students = c.students;
  seats = c.seats;
}

function load(){
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      if(Array.isArray(parsed.classes) && parsed.classes.length){
        classes = parsed.classes;
        currentClassId = parsed.currentClassId;
      } else if(Array.isArray(parsed.students)){
        // altes Format ohne Klassen -> in eine erste Klasse migrieren
        const id = uid();
        classes = [{ id, name: 'Klasse 1', students: parsed.students || [], seats: parsed.seats || {} }];
        currentClassId = id;
      }
      classes.forEach(c => c.students.forEach(migrateStudent));
      if(parsed.displaySettings){
        displaySettings = Object.assign({ grade: true, extraTask: true, extraTime: true }, parsed.displaySettings);
      }
      if(typeof parsed.globalCounterView === 'boolean') globalCounterView = parsed.globalCounterView;
    }
  } catch(e){ console.error("Laden fehlgeschlagen", e); }

  if(classes.length === 0){
    const id = uid();
    classes = [{ id, name: 'Klasse 1', students: [], seats: {} }];
    currentClassId = id;
  }
  if(!classes.find(c => c.id === currentClassId)) currentClassId = classes[0].id;
  syncCurrent();
}

function save(){
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ classes, currentClassId, displaySettings, globalCounterView }));
  } catch(e){ console.error("Speichern fehlgeschlagen", e); }
}

function toggleDisplaySetting(key){
  displaySettings[key] = !displaySettings[key];
  save(); render(); renderDisplayMenu();
}

function addClass(){
  const input = document.getElementById('newClassInput');
  const name = input.value.trim();
  if(!name) return;
  const id = uid();
  classes.push({ id, name, students: [], seats: {} });
  input.value = '';
  currentClassId = id;
  syncCurrent();
  selection = null;
  save(); render();
}

function switchClass(id){
  if(id === currentClassId) return;
  currentClassId = id;
  syncCurrent();
  selection = null;
  closeNotePopover();
  save(); render();
}

let classToDelete = null;
function askDeleteClass(id, e){
  e.stopPropagation();
  classToDelete = id;
  render();
}
function cancelDeleteClass(){ classToDelete = null; render(); }
function confirmDeleteClass(){
  classes = classes.filter(c => c.id !== classToDelete);
  if(classes.length === 0){
    const id = uid();
    classes = [{ id, name: 'Klasse 1', students: [], seats: {} }];
  }
  if(currentClassId === classToDelete || !classes.find(c => c.id === currentClassId)){
    currentClassId = classes[0].id;
  }
  classToDelete = null;
  syncCurrent();
  selection = null;
  save(); render();
}

const NEUTRAL_COLOR = { bg: '#efe6d3', text: '#3a3226' };

function colorFor(points){
  if (points > 5) return { bg: "#1b5e20", text: "#f4f7f2" };
  if (points >= 3) return { bg: "#a8c256", text: "#1b2b12" };
  if (points >= -2) return { bg: "#f2c94c", text: "#2b2408" };
  if (points >= -5) return { bg: "#e07a2c", text: "#2b1a08" };
  return { bg: "#c1392b", text: "#f7ece9" };
}

function seatOf(studentId){
  for(const sid in seats){ if(seats[sid] === studentId) return sid; }
  return null;
}

function addNames(){
  const ta = document.getElementById('nameInput');
  const names = ta.value.split("\n").map(n=>n.trim()).filter(Boolean);
  if(names.length === 0) return;
  names.forEach(name => students.push({ id: uid(), name, points: 0, note: '', grades: [], hasExtraTask: false, extraTime: false }));
  ta.value = "";
  save(); render();
}

function removeStudent(id){
  const sid = seatOf(id);
  if(sid) delete seats[sid];
  students = students.filter(s => s.id !== id);
  cls().students = students;
  if(selection && selection.studentId === id) selection = null;
  save(); render();
}

function changePoints(id, delta){
  const s = students.find(s => s.id === id);
  if(s){ s.points += delta; save(); render(); }
}

let noteTargetId = null;
let gradePreviewTargetId = null;

function positionPopover(pop, btnEl, width, height){
  const rect = btnEl.getBoundingClientRect();
  let left = rect.right + 8;
  if(left + width > window.innerWidth - 10) left = rect.left - width - 8;
  if(left < 10) left = 10;
  let top = rect.top;
  if(top + height > window.innerHeight - 10) top = window.innerHeight - height - 10;
  pop.style.left = left + 'px';
  pop.style.top = Math.max(10, top) + 'px';
}

function toggleGradeReveal(studentId, btnEl){
  const pop = document.getElementById('gradePreview');
  if(gradePreviewTargetId === studentId && pop.classList.contains('open')){
    closeGradePreview();

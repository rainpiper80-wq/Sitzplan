  if(gcp && gcp.classList.contains('open') && !gcp.contains(e.target) && !(e.target.closest && e.target.closest('.grade-chip-value'))){ closeGradeCommentPopover(); }

});

function placeStudent(studentId, fromSeat, targetSeat){
  const occupant = seats[targetSeat];
  if(fromSeat) delete seats[fromSeat];
  if(occupant && occupant !== studentId){
    if(fromSeat) seats[fromSeat] = occupant;
    else delete seats[targetSeat];
  }
  seats[targetSeat] = studentId;
  save(); render();
}

function unassignFromSeat(fromSeat){
  if(!fromSeat) return;
  delete seats[fromSeat];
  save(); render();
}

function handleChipClick(studentId){
  if(!selection){ selection = { studentId, fromSeat: null }; render(); return; }
  if(selection.studentId === studentId){ selection = null; render(); return; }
  selection = { studentId, fromSeat: null };
  render();
}

function handleSeatClick(seatId){
  const occupantId = seats[seatId];
  if(!selection){
    if(occupantId) selection = { studentId: occupantId, fromSeat: seatId };
    render(); return;
  }
  if(selection.fromSeat === seatId){ selection = null; render(); return; }
  placeStudent(selection.studentId, selection.fromSeat, seatId);
  selection = null;
}

function handleListAreaClick(e){
  if(e.target.id === 'chipList' && selection && selection.fromSeat){
    unassignFromSeat(selection.fromSeat);
    selection = null; render();
  }
}

// Drag & Drop
function onDragStart(e, studentId, fromSeat){
  e.dataTransfer.setData("text/plain", JSON.stringify({ studentId, fromSeat }));
}
function onSeatDrop(e, seatId){
  e.preventDefault();
  try {
    const { studentId, fromSeat } = JSON.parse(e.dataTransfer.getData("text/plain"));
    placeStudent(studentId, fromSeat, seatId);
    selection = null;
  } catch(_){}
}
function onListDrop(e){
  e.preventDefault();
  try {
    const { studentId, fromSeat } = JSON.parse(e.dataTransfer.getData("text/plain"));
    if(fromSeat) unassignFromSeat(fromSeat);
    selection = null; render();
  } catch(_){}
}

async function triggerPdfPicker(){
  // Moderne Chromium-Browser (Chrome, Edge) können den Dialog direkt im
  // Downloads-Ordner öffnen. Andere Browser (Firefox, Safari) unterstützen
  // das nicht -> dann normaler Dateidialog als Rückfallebene.
  if(window.showOpenFilePicker){
    try {
      const [handle] = await window.showOpenFilePicker({
        startIn: 'downloads',
        types: [{ description: 'PDF-Dateien', accept: { 'application/pdf': ['.pdf'] } }],
        multiple: false
      });
      const file = await handle.getFile();
      processPdfFile(file);
      return;
    } catch(e){
      if(e && e.name === 'AbortError') return; // Nutzer hat Dialog abgebrochen
      // sonst: still auf klassischen Dialog zurückfallen
    }
  }
  document.getElementById('pdfFile').click();
}

async function handlePdfFile(event){
  const file = event.target.files[0];
  event.target.value = '';
  if(!file) return;
  processPdfFile(file);
}

async function processPdfFile(file){
  const msgEl = document.getElementById('pdfMsg');

  if(typeof pdfjsLib === 'undefined' || window.__pdfLibMissing){
    msgEl.className = 'backup-msg error';
    msgEl.innerHTML = 'PDF-Bibliothek fehlt noch. Lade diese zwei Dateien einmalig herunter und lege sie in denselben Ordner wie diese HTML-Datei:<br>' +
      '<a href="" target="_blank" rel="noopener">pdf.min.js</a> · ' +
      '<a href="" target="_blank" rel="noopener">pdf.worker.min.js</a><br>' +
      'Danach diese Seite neu laden.';
    return;
  }

  try {
    msgEl.className = 'backup-msg';
    msgEl.textContent = 'Lese PDF ein …';
    const buf = await file.arrayBuffer();
    // Worker deaktiviert: bei file:// (Doppelklick geöffnet) blockieren Browser Web Worker.
    // pdf.worker.min.js wird dadurch nicht benötigt.
    pdfjsLib.disableWorker = true;
    if(pdfjsLib.GlobalWorkerOptions) pdfjsLib.GlobalWorkerOptions.workerSrc = '';
    const pdf = await Promise.race([
      pdfjsLib.getDocument({ data: buf, disableWorker: true }).promise,
      new Promise((_, rej) => setTimeout(() => rej(new Error('Zeitüberschreitung – PDF-Bibliothek antwortet nicht')), 15000))
    ]);
    let lines = [];
    for(let p = 1; p <= pdf.numPages; p++){
      const page = await pdf.getPage(p);
      const content = await page.getTextContent();
      // Textbausteine anhand ihrer Zeilenposition (y-Koordinate) gruppieren
      const rows = {};
      content.items.forEach(item => {
        const y = Math.round(item.transform[5]);
        if(!rows[y]) rows[y] = [];
        rows[y].push(item.str);
      });
      const sortedY = Object.keys(rows).map(Number).sort((a,b) => b - a);
      sortedY.forEach(y => {
        const line = rows[y].join(' ').replace(/\s+/g, ' ').trim();
        if(line) lines.push(line);
      });
    }
    const ta = document.getElementById('nameInput');
    ta.value = lines.join('\n');
    msgEl.textContent = `${lines.length} Zeile(n) erkannt – bitte unten prüfen und Nicht-Namen (z. B. Überschriften) vor dem Hinzufügen entfernen.`;
  } catch(e){
    msgEl.className = 'backup-msg error';
    msgEl.textContent = 'PDF konnte nicht gelesen werden: ' + e.message;
  }
}

function pad(n){ return n.toString().padStart(2,'0'); }

function exportBackup(){
  const data = { classes, currentClassId, exportedAt: new Date().toISOString() };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const now = new Date();
  const filename = `sitzplan-sicherung_${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}.json`;
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  setBackupMsg(`Gespeichert als ${filename}`, false);
}

function importBackup(event){
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const parsed = JSON.parse(reader.result);
      if(Array.isArray(parsed.classes) && parsed.classes.length){
        classes = parsed.classes;
        currentClassId = parsed.currentClassId;
        classes.forEach(c => c.students.forEach(migrateStudent));
        if(!classes.find(c => c.id === currentClassId)) currentClassId = classes[0].id;
        syncCurrent();
      } else if(Array.isArray(parsed.students)){
        // alte Sicherung ohne Klassen -> ersetzt nur die aktuell offene Klasse
        students = parsed.students;
        seats = parsed.seats || {};
        students.forEach(migrateStudent);
        cls().students = students;
        cls().seats = seats;
      } else {
        throw new Error('Ungültiges Format');
      }
      selection = null;
      save(); render();
      setBackupMsg('Sicherung erfolgreich geladen.', false);
    } catch(e){
      setBackupMsg('Datei konnte nicht gelesen werden – ist es eine gültige Sicherungsdatei?', true);
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

function setBackupMsg(text, isError){
  const el = document.getElementById('backupMsg');
  if(!el) return;
  el.textContent = text;
  el.className = 'backup-msg' + (isError ? ' error' : '');
}

function showConfirm(mode){ confirmMode = mode; render(); }
function cancelConfirm(){ confirmMode = null; render(); }
function resetSeatsOnly(){ seats = {}; cls().seats = seats; selection = null; confirmMode = null; save(); render(); }
function resetEverything(){ seats = {}; students = []; cls().seats = seats; cls().students = students; selection = null; confirmMode = null; save(); render(); }

function renderClassBar(){
  const bar = document.getElementById('classBar');
  bar.innerHTML = '';
  classes.forEach(c => {
    const tab = document.createElement('div');
    tab.className = 'class-tab' + (c.id === currentClassId ? ' active' : '');
    tab.onclick = () => switchClass(c.id);

    if(classToDelete === c.id){
      tab.innerHTML = `<span>${escapeHtml(c.name)} löschen?</span>`;
      const yesBtn = document.createElement('button');
      yesBtn.className = 'class-del';
      yesBtn.textContent = '✓';
      yesBtn.setAttribute('aria-label', 'Löschen bestätigen');
      yesBtn.onclick = (e) => { e.stopPropagation(); confirmDeleteClass(); };
      const noBtn = document.createElement('button');
      noBtn.className = 'class-del';
      noBtn.textContent = '✕';
      noBtn.setAttribute('aria-label', 'Löschen abbrechen');
      noBtn.onclick = (e) => { e.stopPropagation(); cancelDeleteClass(); };
      tab.appendChild(yesBtn);
      tab.appendChild(noBtn);
    } else {
      const nameSpan = document.createElement('span');
      nameSpan.textContent = c.name;
      tab.appendChild(nameSpan);
      const delBtn = document.createElement('button');
      delBtn.className = 'class-del';
      delBtn.textContent = '✕';
      delBtn.title = 'Klasse löschen';
      delBtn.setAttribute('aria-label', 'Klasse ' + c.name + ' löschen');
      delBtn.onclick = (e) => askDeleteClass(c.id, e);
      tab.appendChild(delBtn);
    }
    bar.appendChild(tab);
  });

  const addWrap = document.createElement('div');
  addWrap.className = 'new-class';
  addWrap.innerHTML = `
    <input id="newClassInput" type="text" placeholder="z.B. 7a" onkeydown="if(event.key==='Enter') addClass()">
    <button onclick="addClass()">+ Klasse</button>`;
  bar.appendChild(addWrap);

  const displayWrap = document.createElement('div');
  displayWrap.className = 'display-settings-wrap';
  displayWrap.innerHTML = `
    <button class="counter-view-btn${globalCounterView ? ' active' : ''}" onclick="toggleGlobalCounterView()" title="Zeigt Farben & Punkte fuer alle Schueler gleichzeitig" aria-label="Zaehleransicht umschalten">🔢 Zähleransicht: ${globalCounterView ? 'An' : 'Aus'}</button>
    <button id="displaySettingsBtn" class="display-settings-btn" onclick="toggleDisplayMenu(event)" aria-label="Anzeigeoptionen öffnen">⚙ Anzeige</button>
    <button class="print-btn" onclick="printSeatingPlan()" title="Sitzplan als PDF drucken (Querformat, eine Seite)" aria-label="Sitzplan drucken">🖨️ Als PDF drucken</button>
    <button class="print-btn" onclick="exportGradeList()" title="Notenliste drucken oder als PDF speichern" aria-label="Notenliste exportieren">📋 Notenliste exportieren</button>`;
  bar.appendChild(displayWrap);
}

function toggleDisplayMenu(e){
  e.stopPropagation();
  const menu = document.getElementById('displayMenu');
  if(menu.classList.contains('open')){
    menu.classList.remove('open');
    return;
  }
  renderDisplayMenu();
  menu.classList.add('open');
  const btn = document.getElementById('displaySettingsBtn');
  positionPopover(menu, btn, 220, 150);
}

function renderDisplayMenu(){
  const menu = document.getElementById('displayMenu');
  menu.innerHTML = `
    <div class="dm-title">Im Sitzplan anzeigen</div>
    <label class="dm-row"><input type="checkbox" ${displaySettings.grade ? 'checked' : ''} onchange="toggleDisplaySetting('grade')"> Zusatznote (ZN)</label>
    <label class="dm-row"><input type="checkbox" ${displaySettings.extraTime ? 'checked' : ''} onchange="toggleDisplaySetting('extraTime')"> Zeitzuschlag 🕐</label>
    <label class="dm-row"><input type="checkbox" ${displaySettings.extraTask ? 'checked' : ''} onchange="toggleDisplaySetting('extraTask')"> Zusatzaufgabe !</label>`;
}

function render(){
  renderClassBar();
  document.getElementById('classFooter').textContent = cls().name;

  const blocksEl = document.getElementById('blocks');
  blocksEl.innerHTML = "";
  BLOCKS.forEach(block => {
    const wrap = document.createElement('div');
    const title = document.createElement('div');
    title.className = 'block-title';
    title.textContent = block.label;
    wrap.appendChild(title);

    const grid = document.createElement('div');
    grid.className = 'grid';
    grid.style.gridTemplateColumns = `repeat(${block.cols}, var(--seat-size))`;
    grid.style.gridTemplateRows = `repeat(${block.rows}, var(--seat-height))`;

    for(let r=1; r<=block.rows; r++){
      for(let c=1; c<=block.cols; c++){
        const seatId = `${block.id}-${r}-${c}`;
        const studentId = seats[seatId];
        const student = students.find(s => s.id === studentId);
        const seatEl = document.createElement('div');
        seatEl.onclick = () => handleSeatClick(seatId);
        seatEl.ondrop = (e) => onSeatDrop(e, seatId);
        seatEl.ondragover = (e) => e.preventDefault();

        if(!student){
          seatEl.className = 'seat empty';
        } else {
          const revealed = globalCounterView || revealedPoints.has(student.id);
          const col = revealed ? colorFor(student.points) : NEUTRAL_COLOR;
          seatEl.className = 'seat filled' + (selection && selection.studentId === student.id ? ' selected' : '');
          seatEl.style.background = col.bg;
          seatEl.style.color = col.text;
          seatEl.draggable = true;
          seatEl.ondragstart = (e) => onDragStart(e, student.id, seatId);
          seatEl.innerHTML = `
            ${(student.grades && student.grades.length && displaySettings.grade) ? `<button class="badge-grade" title="Noten & Notiz anzeigen" onclick="event.stopPropagation(); toggleGradeReveal('${student.id}', this)">ZN</button>` : ''}
            ${(student.hasExtraTask && displaySettings.extraTask) ? `<div class="badge-task" title="Zusatzaufgabe offen">!</div>` : ''}
            ${(student.extraTime && displaySettings.extraTime) ? `<div class="badge-time" title="Zeitzuschlag (LRS/Legasthenie)">🕐</div>` : ''}
            <button class="note-btn${(student.note || (student.grades && student.grades.length)) ? ' has-note' : ''}" title="Notiz / Zusatzaufgabe / Note" onclick="event.stopPropagation(); openNotePopover('${student.id}', this)">📝</button>
            <div class="name" onclick="event.stopPropagation(); togglePointsReveal('${student.id}')" title="Klicken für Punkteanzeige">${escapeHtml(student.name)}</div>
            ${revealed ? `
            <div class="points">${student.points}</div>
            <div class="btns">
              <button onclick="event.stopPropagation(); changePoints('${student.id}', -1)">−</button>
              <button onclick="event.stopPropagation(); changePoints('${student.id}', 1)">+</button>
            </div>` : ''}`;
        }
        grid.appendChild(seatEl);
      }
    }
    wrap.appendChild(grid);
    blocksEl.appendChild(wrap);
  });

  const unseated = students.filter(s => !Object.values(seats).includes(s.id));
  document.getElementById('unseatedCount').textContent = unseated.length;
  document.getElementById('totalCount').textContent = students.length;

  const chipList = document.getElementById('chipList');
  chipList.innerHTML = "";
  chipList.onclick = handleListAreaClick;
  chipList.ondrop = onListDrop;
  chipList.ondragover = (e) => e.preventDefault();

  if(unseated.length === 0 && students.length > 0){
    chipList.innerHTML = '<div class="empty-note">Alle Schüler sitzen bereits.</div>';
  } else if(students.length === 0){
    chipList.innerHTML = '<div class="empty-note">Noch keine Schüler hinzugefügt.</div>';
  } else {
    unseated.forEach(s => {
      const revealed = globalCounterView || revealedPoints.has(s.id);
      const col = revealed ? colorFor(s.points) : NEUTRAL_COLOR;
      const chip = document.createElement('div');
      chip.className = 'chip' + (selection && selection.studentId === s.id ? ' selected' : '');
      chip.style.background = col.bg;
      chip.style.color = col.text;
      chip.draggable = true;
      chip.ondragstart = (e) => onDragStart(e, s.id, null);
      chip.onclick = () => handleChipClick(s.id);
      chip.innerHTML = `
        <div class="chip-top">
          <span class="cname" onclick="event.stopPropagation(); togglePointsReveal('${s.id}')" title="Klicken für Punkteanzeige">${escapeHtml(s.name)}</span>
          ${(s.grades && s.grades.length && displaySettings.grade) ? `<button class="chip-badge-grade" title="Noten & Notiz anzeigen" onclick="event.stopPropagation(); toggleGradeReveal('${s.id}', this)">ZN</button>` : ''}
          ${(s.hasExtraTask && displaySettings.extraTask) ? `<span class="chip-badge-task" title="Zusatzaufgabe offen">!</span>` : ''}
          ${(s.extraTime && displaySettings.extraTime) ? `<span class="chip-badge-time" title="Zeitzuschlag (LRS/Legasthenie)">🕐</span>` : ''}
          <button class="del" onclick="event.stopPropagation(); removeStudent('${s.id}')">✕</button>
        </div>
        <div class="chip-bottom">
          ${revealed ? `
          <span class="cbtns">
            <button onclick="event.stopPropagation(); changePoints('${s.id}', -1)">−</button>
            <span style="font-size:13px;font-weight:700;min-width:16px;text-align:center;">${s.points}</span>
            <button onclick="event.stopPropagation(); changePoints('${s.id}', 1)">+</button>
          </span>` : '<span></span>'}
          <button class="note-btn-inline${(s.note || (s.grades && s.grades.length)) ? ' has-note' : ''}" title="Notiz / Zusatzaufgabe / Note" onclick="event.stopPropagation(); openNotePopover('${s.id}', this)">📝</button>
        </div>`;
      chipList.appendChild(chip);
    });
  }

  const resetArea = document.getElementById('resetArea');
  if(confirmMode === null){
    resetArea.innerHTML = `
      <button class="reset-btn" onclick="showConfirm('seats')">↺ Sitzplan leeren</button>
      <button class="reset-btn danger-btn" onclick="showConfirm('all')">🗑 Alles löschen</button>`;
  } else {
    const msg = confirmMode === 'seats'
      ? 'Sitzplan wirklich leeren? Punkte bleiben erhalten.'
      : 'Wirklich alle Schüler und Punkte dieser Klasse löschen? Das kann nicht rückgängig gemacht werden.';
    const action = confirmMode === 'seats' ? 'resetSeatsOnly()' : 'resetEverything()';
    resetArea.innerHTML = `
      <div class="confirm-box">
        ${msg}
        <div class="row">
          <button style="background:#c1392b;color:#fff;" onclick="${action}">Ja, löschen</button>
          <button style="background:#e4d9bf;" onclick="cancelConfirm()">Abbrechen</button>
        </div>
      </div>`;
  }
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

load();
render();
</script>

<script>
(function () {
  const AUTO_KEY = "sitzplan_autosave";
  const SAVE_INTERVAL = 2000;

  function saveSnapshot() {
    try {
      const snapshot = {};
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key !== AUTO_KEY) snapshot[key] = localStorage.getItem(key);
      }
      localStorage.setItem(AUTO_KEY, JSON.stringify({
        timestamp: new Date().toISOString(),
        data: snapshot
      }));
    } catch (e) {
      console.warn("Automatische Sicherung nicht möglich:", e);
    }
  }

  const originalSetItem = Storage.prototype.setItem;
  const originalRemoveItem = Storage.prototype.removeItem;
  const originalClear = Storage.prototype.clear;

  Storage.prototype.setItem = function(key, value) {
    const result = originalSetItem.apply(this, arguments);
    if (this === localStorage && key !== AUTO_KEY) {
      clearTimeout(window.__sitzplanSaveTimer);
      window.__sitzplanSaveTimer = setTimeout(saveSnapshot, 100);
    }
    return result;
  };

  Storage.prototype.removeItem = function(key) {
    const result = originalRemoveItem.apply(this, arguments);
    if (this === localStorage && key !== AUTO_KEY) {
      clearTimeout(window.__sitzplanSaveTimer);
      window.__sitzplanSaveTimer = setTimeout(saveSnapshot, 100);
    }
    return result;
  };

  Storage.prototype.clear = function() {
    const result = originalClear.apply(this, arguments);
    if (this === localStorage) {
      clearTimeout(window.__sitzplanSaveTimer);
      window.__sitzplanSaveTimer = setTimeout(saveSnapshot, 100);
    }
    return result;
  };

  setInterval(saveSnapshot, SAVE_INTERVAL);
  window.addEventListener("beforeunload", saveSnapshot);
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "hidden") saveSnapshot();
  });
  setTimeout(saveSnapshot, 300);
})();
</script>


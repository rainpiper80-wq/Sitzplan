  document.getElementById('notePopoverGradeInput').focus();
}

function toggleNoteTask(){
  if(!noteTargetId) return;
  const s = students.find(s => s.id === noteTargetId);
  if(!s) return;
  s.hasExtraTask = !s.hasExtraTask;
  updateTaskToggleUI(s.hasExtraTask);
  save(); render();
}

function toggleExtraTime(){
  if(!noteTargetId) return;
  const s = students.find(s => s.id === noteTargetId);
  if(!s) return;
  s.extraTime = !s.extraTime;
  updateTimeToggleUI(s.extraTime);
  save(); render();
}

function addGradeEntry(){
  if(!noteTargetId) return; const input=document.getElementById('notePopoverGradeInput'),value=input.value.trim(); if(!value)return;
  const s=students.find(s => s.id === noteTargetId); if(!s)return; if(!Array.isArray(s.grades))s.grades=[];s.grades.push({value:value,comment:''});input.value='';renderGradeList();save();render();input.focus();
}

let gradeCommentIndex = null;
function openGradeCommentPopover(index, el){
  gradeCommentIndex=index;const s=students.find(s => s.id === noteTargetId);if(!s || !s.grades[index])return;const pop=document.getElementById('gradeCommentPopover');document.getElementById('gradeCommentTitle').textContent='Kommentar zu Note „'+s.grades[index].value+'\u201c';document.getElementById('gradeCommentText').value=s.grades[index].comment||'';pop.classList.add('open');positionPopover(pop,el,220,150);document.getElementById('gradeCommentText').focus();
}
function onGradeCommentInput(value){if(gradeCommentIndex===null||!noteTargetId)return;const s=students.find(s=>s.id===noteTargetId);if(!s||!s.grades[gradeCommentIndex])return;s.grades[gradeCommentIndex].comment=value;renderGradeList();save();render();}
function closeGradeCommentPopover(){gradeCommentIndex=null;const pop=document.getElementById('gradeCommentPopover');if(pop)pop.classList.remove('open');}

function removeGradeEntry(index){
  if(!noteTargetId) return;
  const s = students.find(s => s.id === noteTargetId);
  if(!s || !Array.isArray(s.grades)) return;
  s.grades.splice(index, 1);
  renderGradeList();
  save(); render();
}

function onNoteInput(value){
  if(!noteTargetId) return;
  const s = students.find(s => s.id === noteTargetId);
  if(!s) return;
  s.note = value;
  save(); render();
}

function closeNotePopover(){
  noteTargetId = null;
  document.getElementById('notePopover').classList.remove('open');
  render();
}

document.addEventListener('click', (e) => {
  const pop = document.getElementById('notePopover');
